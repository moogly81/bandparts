# direnv configuration - https://direnv.net
#
# Enter the Nix dev shell when Nix is available, and fall back to whatever is
# already on PATH otherwise (the tools are all available via Homebrew too).
#
# First use:   direnv allow

if has nix; then
  watch_file flake.nix flake.lock
  use flake
else
  echo "direnv: nix not found - using tools from PATH (brew install qpdf poppler ocrmypdf exiftool)"
fi

# keep generated parts out of the way of other tooling
export BANDPARTS_INBOX="$PWD/inbox"
export BANDPARTS_PARTS="$PWD/parts"
PATH_add "$PWD/bin"
