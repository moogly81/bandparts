# Charts and generated parts stay out of git: they are copyrighted material.
# One rule over the whole tree rather than a rule per folder, because the
# cost of getting this wrong is publishing someone else's score.
data/

__pycache__/
*.py[cod]
.venv/
.DS_Store
result

# scratch space for scripts/build-image
.image-build/

# direnv's cache: symlinks into this machine's /nix/store, meaningless
# anywhere else and dangling in a fresh clone
.direnv/
